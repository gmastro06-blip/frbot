# FRBot local environment template (copy to .env)
# OBS source capture (Tibia visible in OBS source)
FRBOT_CAPTURE_SOURCE=obs_source
FRBOT_OBS_SOURCE_NAME=Tibia_Fuente
FRBOT_OBS_WS_HOST=127.0.0.1
FRBOT_OBS_WS_PORT=4455
FRBOT_OBS_WS_TIMEOUT_S=2.0

# Runtime profile + ROI config
FRBOT_MODE=real
FRBOT_PROFILE=prod_emergency
FRBOT_CONFIG_PATH=rois_prod_emergency.json
FRBOT_MINIMAP_ROI=minimap

# Calibrated minimap marker defaults (validated in this workspace)
FRBOT_PLAYER_MARKER_RGB=0,200,0
FRBOT_PLAYER_MARKER_TOL=45
FRBOT_PLAYER_MARKER_MIN_PIXELS=5
FRBOT_PLAYER_MARKER_MAX_PIXELS=0
FRBOT_PLAYER_MARKER_MIN_FILL_RATIO=0.15
FRBOT_PLAYER_MARKER_MAX_ASPECT_RATIO=4.0

# World-localization thresholds (recommended defaults)
FRBOT_ROUTE_LOCALIZE_MIN_SCORE=0.55
FRBOT_CAVEBOT_LOCALIZE_MIN_SCORE=0.55

# Optional world-waypoint mode (requires tibiamaps/tibia-map-data)
# FRBOT_TIBIA_MAP_DATA_DIR=C:/path/to/tibia-map-data
# FRBOT_CAVEBOT_WAYPOINT_SPACE=world

# Optional window selector fallback
FRBOT_WINDOW_TITLE=Tibia
